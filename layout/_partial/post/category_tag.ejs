<div class="eof-header-line">
  <span class="eof-key">Content-Type:</span> <span class="eof-mime">application/quantum-stream</span><span class="eof-sep">;</span><% if (post.categories && post.categories.length) { %> <span class="eof-attr">category</span><span class="eof-sep">="</span><% post.categories.data.forEach(function(cat, idx) { %><% if (idx > 0) { %><span class="eof-sep">; </span><% } %><a class="eof-link-cat" href="<%- url_for('/categories/' + cat.name) %>"><%= cat.name %></a><% }) %><span class="eof-sep">";</span><% } %><% if (post.tags && post.tags.length) { %> <span class="eof-attr">tags</span><span class="eof-sep">="</span><% post.tags.data.forEach(function(tag, idx) { %><% if (idx > 0) { %><span class="eof-sep">; </span><% } %><a class="eof-link-tag" href="<%- url_for('/tags/' + tag.name) %>"><%= tag.name %></a><% }) %><span class="eof-sep">"</span><% } %>
</div>
