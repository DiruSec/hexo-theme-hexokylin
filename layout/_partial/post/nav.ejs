<% if (post.prev || post.next){ %>
<nav class="relative-post" aria-label="文章导航">
  <div class="relative-post-item relative-post-prev">
    <% if (post.prev){ %>
      <a class="prevpost" href="<%- url_for(post.prev.path) %>" title="<%= post.prev.title %>">&laquo; <%= post.prev.title %></a>
    <% } %>
  </div>
  <div class="relative-post-item relative-post-next">
    <% if (post.next){ %>
      <a class="nextpost" href="<%- url_for(post.next.path) %>" title="<%= post.next.title %>"><%= post.next.title %> &raquo;</a>
    <% } %>
  </div>
</nav>
<% } %>
