<% if (post.prev || post.next){ %>
<nav class="relative-post" aria-label="文章导航">
  <div class="relative-post-item relative-post-prev">
    <% if (post.prev){ %>
      <a class="prevpost" href="<%- url_for(post.prev.path) %>">
        <span class="relative-post-label">&larr; 上一篇</span>
        <span class="relative-post-title"><%= post.prev.title %></span>
      </a>
    <% } %>
  </div>
  <div class="relative-post-item relative-post-next">
    <% if (post.next){ %>
      <a class="nextpost" href="<%- url_for(post.next.path) %>">
        <span class="relative-post-label">下一篇 &rarr;</span>
        <span class="relative-post-title"><%= post.next.title %></span>
      </a>
    <% } %>
  </div>
</nav>
<% } %>
