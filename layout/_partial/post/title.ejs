<% if (post.link){ %>
  <h2 class="article-heading" itemprop="name">
    <a class="<%= class_name %>" href="<%- url_for(post.link) %>" target="_blank" itemprop="url"><%= post.title %></a>
  </h2>
<% } else if (post.title){ %>
  <% if (index){ %>
    <h2 class="article-heading" itemprop="name">
      <a class="<%= class_name %>" href="<%- url_for(post.path) %>"><%= post.title %></a>
    </h2>
  <% } else { %>
    <h1 class="<%= class_name %> article-title--single" itemprop="name">
      <%= post.title %>
    </h1>
  <% } %>
<% } %>
