<article id="<%= post.layout %>-<%= post.slug %>" class="article article-type-<%= post.layout %> <%= index ? 'article--index' : 'article--single' %>" itemscope itemprop="blogPost">
  <div class="article-meta">
    <% if (post.link || post.title){ %>
      <div class="article-header">
        <%- partial('post/title', {class_name: 'article-title'}) %>
        <% if (!(post.type && post.type.toLowerCase() === 'page') && post.tags && post.tags.length){ %>
          <div class="article-header-tags">
            <% post.tags.data.forEach(function(tag){ %>
              <a class="article-header-tag" href="<%- url_for('/tags/' + tag.name) %>">#<%= tag.name %></a>
            <% }) %>
          </div>
        <% } %>
      </div>
    <% } %>
    <% if (!(post.type && post.type.toLowerCase() === 'page')){ %>
      <%- partial('post/date', {class_name: 'article-date', date_format: "YYYY-MM-DD HH:mm"}) %>
    <% } %>
  </div>
  <div class="article-content article-entry">
    <%- partial('post/gallery') %>
      <% if (post.excerpt && index){ %>
        <div class="article-excerpt-row">
          <div class="article-excerpt-body"><%- post.excerpt %></div>
          <% if (theme.excerpt_link){ %>
            <a class="article-more-link" href="<%- url_for(post.path) %>"><%= theme.excerpt_link %> &raquo;</a>
          <% } %>
        </div>
      <% } else { %>
        <%- post.content %>
      <% } %>
  </div>
  <% if (!index){ %>
    <div class="article-footer">
      <% if (!(post.type && post.type.toLowerCase() === 'page')){ %>
        <div class="eof-headers">
          <%- partial('post/article_date') %>
          <%- partial('post/category_tag') %>
        </div>
      <% } %>
    </div>
    <%- partial('post/nav') %>
  <% } %>
</article>

<% if (!index && post.comments && config.disqus_shortname){ %>
<section id="comments">
  <div id="<%= config.disqusjs ? 'disqusjs' : 'disqus_thread' %>">
    <noscript>Please enable JavaScript to view the <a href="//disqus.com/?ref_noscript">comments powered by Disqus.</a></noscript>
  </div>
</section>
<% } %>
