:root
  color-scheme: light
  --theme-bg: #ffffff
  --theme-text: #374151
  --theme-heading: #111827
  --theme-muted: #6b7280
  --theme-border: #e5e7eb
  --theme-border-soft: #eef0f3
  --theme-border-accent: #cbd5e1
  --theme-link: #258fb8
  --theme-link-hover: #1a6e8f
  --theme-link-underline: rgba(37, 143, 184, 0.35)
  --theme-surface: #ffffff
  --theme-surface-strong: #f6f8fa
  --theme-shadow: rgba(15, 23, 42, 0.08)
  --theme-sidebar-bg: #181c22
  --theme-sidebar-text: #ffffff
  --theme-sidebar-border: rgba(0, 0, 0, 0.08)
  --theme-toolbar-bg: rgba(255, 255, 255, 0.12)
  --theme-toolbar-bg-hover: rgba(255, 255, 255, 0.2)
  --theme-code-bg: #fafafa
  --theme-code-text: #383a42
  --theme-code-inline-bg: #f2f4f7
  --theme-mobile-border: #ffffff
  --theme-header-bg: #181c22
  --theme-overlay: rgba(0, 0, 0, 0.25)
  /* One Monokai Light syntax & HTTP header tokens */
  --eof-key: #2563eb
  --eof-attr: #a17408
  --eof-val: #383a42
  --eof-mime: #9c36b5
  --eof-sep: #8c929d
  --eof-cat: #2f855a
  --eof-tag: #c53068

html[data-theme='dark']
  color-scheme: dark
  --theme-bg: #0f1216
  --theme-text: #d1d5db
  --theme-heading: #f3f4f6
  --theme-muted: #9ca3af
  --theme-border: #2b313c
  --theme-border-soft: #1f252e
  --theme-border-accent: #3b4656
  --theme-link: #7ab8ff
  --theme-link-hover: #9ecbff
  --theme-link-underline: rgba(122, 184, 255, 0.35)
  --theme-surface: #151a21
  --theme-surface-strong: #191f28
  --theme-shadow: rgba(0, 0, 0, 0.45)
  --theme-sidebar-bg: #0b0f14
  --theme-sidebar-text: #f4f7fb
  --theme-sidebar-border: rgba(255, 255, 255, 0.08)
  --theme-toolbar-bg: rgba(255, 255, 255, 0.08)
  --theme-toolbar-bg-hover: rgba(255, 255, 255, 0.16)
  --theme-code-bg: #282c34
  --theme-code-text: #abb2bf
  --theme-code-inline-bg: #21252b
  --theme-mobile-border: rgba(255, 255, 255, 0.18)
  --theme-header-bg: #0b0f14
  --theme-overlay: rgba(0, 0, 0, 0.45)
  /* One Monokai Dark syntax & HTTP header tokens */
  --eof-key: #61afef
  --eof-attr: #e5c07b
  --eof-val: #abb2bf
  --eof-mime: #c678dd
  --eof-sep: #676f7d
  --eof-cat: #98c379
  --eof-tag: #e06c75

html, body
  background: var(--theme-bg)

body
  color: var(--theme-text)
  transition: background-color .35s ease, color .35s ease, transform .2s cubic-bezier(.4,.01,.165,.99)

a
  color: var(--theme-link)

a:hover
  color: var(--theme-link-hover)

.wrap
  background-color: var(--theme-bg)
  transition: background-color .35s ease, color .35s ease

.sidebar
  background-color: var(--theme-sidebar-bg)
  box-shadow: 2px 0 16px var(--theme-shadow)
  transition: background-color .35s ease, box-shadow .35s ease

#header
  transition: border-color .35s ease, box-shadow .35s ease, background-color .35s ease

header
  background-color: var(--theme-header-bg)
  transition: background-color .35s ease, box-shadow .35s ease

.article-share-box
  background-color: var(--theme-surface)
  border: 1px solid var(--theme-border)
  box-shadow: 1px 2px 10px var(--theme-shadow)

.article-share-input
  background-color: transparent
  border-color: var(--theme-border)
  color: var(--theme-text)

.article-share-links
  background-color: var(--theme-surface)

/* One Monokai Adaptive Palette (Light: #fafafa, Dark: #282c34) */
.hljs
  background: var(--theme-code-bg)
  color: var(--theme-code-text)
  padding: 0

.hljs-comment,
.hljs-quote
  color: #8c929d
  font-style: italic

.hljs-keyword,
.hljs-selector-tag,
.hljs-subst,
.hljs-tag,
.hljs-name
  color: #e05260

.hljs-number,
.hljs-literal,
.hljs-variable,
.hljs-template-variable,
.hljs-symbol,
.hljs-bullet
  color: #9c36b5

.hljs-string,
.hljs-doctag,
.hljs-regexp
  color: #a17408

.hljs-title,
.hljs-section,
.hljs-selector-id,
.hljs-attribute
  color: #408f3d
  font-weight: 600

.hljs-type,
.hljs-class .hljs-title,
.hljs-built_in,
.hljs-builtin-name
  color: #0c8599

.hljs-meta,
.hljs-link,
.hljs-tag .hljs-attr
  color: #2563eb

.hljs-addition
  color: #2f855a
  background-color: #e6ffed

.hljs-deletion
  color: #cb2431
  background-color: #ffeef0

html[data-theme='dark']
  .hljs-comment,
  .hljs-quote
    color: #676f7d

  .hljs-keyword,
  .hljs-selector-tag,
  .hljs-subst,
  .hljs-tag,
  .hljs-name
    color: #e06c75

  .hljs-number,
  .hljs-literal,
  .hljs-variable,
  .hljs-template-variable,
  .hljs-symbol,
  .hljs-bullet
    color: #c678dd

  .hljs-string,
  .hljs-doctag,
  .hljs-regexp
    color: #e5c07b

  .hljs-title,
  .hljs-section,
  .hljs-selector-id,
  .hljs-attribute
    color: #98c379

  .hljs-type,
  .hljs-class .hljs-title,
  .hljs-built_in,
  .hljs-builtin-name
    color: #56b6c2

  .hljs-meta,
  .hljs-link,
  .hljs-tag .hljs-attr
    color: #61afef

  .hljs-addition
    color: #98c379
    background-color: rgba(152, 195, 121, 0.14)

  .hljs-deletion
    color: #e06c75
    background-color: rgba(224, 108, 117, 0.14)
